# Conexión a Postgres (en Coolify: la "Postgres URL (internal)" de la base de datos)
DATABASE_URL=postgres://payload:payload@127.0.0.1:5432/payload

# Cadena aleatoria larga: openssl rand -hex 32
PAYLOAD_SECRET=

# URL pública del CMS, sin barra final
PAYLOAD_PUBLIC_SERVER_URL=http://localhost:3000

# Opcional. Carpeta de las imágenes subidas (por defecto ./media; en Docker /app/media)
# MEDIA_DIR=

# Opcional. Build hook de Netlify: al publicar o cambiar un artículo publicado se regenera el blog
# NETLIFY_BUILD_HOOK_URL=https://api.netlify.com/build_hooks/xxxxxxxx
